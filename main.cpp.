
#include <iostream>
#include <string>
#include <vector>
#include <iomanip>
#include <algorithm>

using namespace std;

class Person {
private:
    string name;
    string surname;
    vector<double> homework;
    double exam;
    double finalGrade;

public:
    // Default constructor
    Person() : exam(0.0), finalGrade(0.0) {}

    // Copy constructor
    Person(const Person& other)
        : name(other.name),
          surname(other.surname),
          homework(other.homework),
          exam(other.exam),
          finalGrade(other.finalGrade) {}

    // Assignment-copy operator
    Person& operator=(const Person& other) {
        if (this != &other) {
            name = other.name;
            surname = other.surname;
            homework = other.homework;
            exam = other.exam;
            finalGrade = other.finalGrade;
        }
        return *this;
    }

    // Destructor
    ~Person() = default;

    // Input operator
    friend istream& operator>>(istream& in, Person& p) {
        cout << "First name: ";
        in >> p.name;

        cout << "Surname: ";
        in >> p.surname;

        p.homework.clear();

        cout << "Enter homework grades one by one.\n";
        cout << "Enter -1 when finished.\n";

        double grade;

        while (true) {
            cout << "Homework grade: ";
            in >> grade;

            if (!in) {
                return in;
            }

            if (grade == -1) {
                break;
            }

            if (grade < 0 || grade > 10) {
                cout << "Grade must be between 0 and 10.\n";
                continue;
            }

            p.homework.push_back(grade);
        }

        cout << "Exam grade (0-10): ";
        in >> p.exam;

        return in;
    }

    // Output operator
    friend ostream& operator<<(ostream& out, const Person& p) {
        out << left << setw(15) << p.name
            << setw(15) << p.surname
            << right << fixed << setprecision(2)
            << p.finalGrade;

        return out;
    }

    // Calculate final grade using average or median
    void calculateFinalGrade(char method) {
        if (homework.empty()) {
            finalGrade = 0.6 * exam;
            return;
        }

        double homeworkResult = 0.0;

        if (method == 'A' || method == 'a') {
            for (double grade : homework) {
                homeworkResult += grade;
            }

            homeworkResult /= homework.size();
        } else {
            vector<double> sortedHomework = homework;

            sort(sortedHomework.begin(), sortedHomework.end());

            size_t middle = sortedHomework.size() / 2;

            if (sortedHomework.size() % 2 == 0) {
                homeworkResult =
                    (sortedHomework[middle - 1] +
                     sortedHomework[middle]) / 2.0;
            } else {
                homeworkResult = sortedHomework[middle];
            }
        }

        finalGrade = 0.4 * homeworkResult + 0.6 * exam;
    }
};

int main() {
    int numberOfStudents;
    char method;

    cout << "Choose calculation method:\n";
    cout << "A - Average\n";
    cout << "M - Median\n";
    cout << "Your choice: ";
    cin >> method;

    if (method != 'A' && method != 'a' &&
        method != 'M' && method != 'm') {
        cout << "Invalid calculation method.\n";
        return 1;
    }

    cout << "How many students? ";
    cin >> numberOfStudents;

    if (numberOfStudents <= 0) {
        cout << "Number of students must be positive.\n";
        return 1;
    }

    vector<Person> students(numberOfStudents);

    for (int i = 0; i < numberOfStudents; i++) {
        cout << "\nStudent " << i + 1 << '\n';

        cin >> students[i];

        if (!cin) {
            cout << "Invalid input.\n";
            return 1;
        }

        students[i].calculateFinalGrade(method);
    }

    cout << "\nFinal grades using "
         << ((method == 'A' || method == 'a')
                 ? "Average"
                 : "Median")
         << ":\n";

    cout << left << setw(15) << "Name"
         << setw(15) << "Surname"
         << "Final_Point\n";

    cout << string(42, '-') << '\n';

    for (const Person& student : students) {
        cout << student << '\n';
    }

    return 0;
}
