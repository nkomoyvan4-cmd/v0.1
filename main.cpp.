
#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
#include <string>
#include <sstream>
#include <fstream>
#include <random>
#include <limits>

using namespace std;

class Person {
private:
    string firstName;
    string surname;
    vector<double> homework;
    double examGrade;

public:
    Person() : examGrade(0) {}

    Person(string first, string last,
           vector<double> hw, double exam)
        : firstName(first), surname(last),
          homework(hw), examGrade(exam) {}

    // Copy constructor
    Person(const Person& other)
        : firstName(other.firstName),
          surname(other.surname),
          homework(other.homework),
          examGrade(other.examGrade) {}

    // Assignment operator
    Person& operator=(const Person& other) {
        if (this != &other) {
            firstName = other.firstName;
            surname = other.surname;
            homework = other.homework;
            examGrade = other.examGrade;
        }
        return *this;
    }

    // Destructor
    ~Person() {}

    double average() const {
        if (homework.empty()) return 0;

        double sum = 0;
        for (double grade : homework)
            sum += grade;

        return sum / homework.size();
    }

    double median() const {
        if (homework.empty()) return 0;

        vector<double> grades = homework;
        sort(grades.begin(), grades.end());

        int n = static_cast<int>(grades.size());

        if (n % 2 == 1)
            return grades[n / 2];

        return (grades[n / 2 - 1] +
                grades[n / 2]) / 2.0;
    }

    double finalAverage() const {
        return 0.4 * average() + 0.6 * examGrade;
    }

    double finalMedian() const {
        return 0.4 * median() + 0.6 * examGrade;
    }

    string getFirstName() const {
        return firstName;
    }

    string getSurname() const {
        return surname;
    }

    // Read one student manually
    friend istream& operator>>(istream& in, Person& p) {
        cout << "First name: ";
        in >> p.firstName;

        cout << "Surname: ";
        in >> p.surname;

        int count;
        cout << "Number of homework grades: ";
        in >> count;

        if (!in) return in;

        if (count < 0) {
            in.setstate(ios::failbit);
            return in;
        }

        p.homework.clear();

        for (int i = 0; i < count; i++) {
            double grade;
            cout << "Homework grade " << i + 1 << ": ";
            in >> grade;

            if (!in) return in;
            p.homework.push_back(grade);
        }

        cout << "Exam grade: ";
        in >> p.examGrade;

        return in;
    }

    // Display one student's results
    friend ostream& operator<<(ostream& out,
                               const Person& p) {
        out << left << setw(15) << p.surname
            << setw(15) << p.firstName
            << right << fixed << setprecision(2)
            << setw(12) << p.finalAverage()
            << setw(12) << p.finalMedian();

        return out;
    }

    // Generate random grades
    void randomGrades() {
        static random_device rd;
        static mt19937 gen(rd());
        static uniform_int_distribution<> dist(1, 10);

        homework.clear();

        for (int i = 0; i < 5; i++)
            homework.push_back(dist(gen));

        examGrade = dist(gen);
    }
};

// Sort and display students
void printTable(vector<Person>& students) {
    sort(students.begin(), students.end(),
         [](const Person& a, const Person& b) {
             if (a.getSurname() != b.getSurname())
                 return a.getSurname() < b.getSurname();

             return a.getFirstName() < b.getFirstName();
         });

    cout << "\n";
    cout << left << setw(15) << "Surname"
         << setw(15) << "First name"
         << right << setw(12) << "Average"
         << setw(12) << "Median" << "\n";

    cout << string(54, '-') << "\n";

    for (const Person& p : students)
        cout << p << "\n";
}

// Read a selected dataset
bool readStudents(const string& filename,
                  vector<Person>& students) {
    ifstream file(filename);

    if (!file.is_open()) {
        cout << "\nError: Cannot open " << filename << "\n";
        cout << "Check that the file is in the working folder.\n";
        return false;
    }

    string line;

    // Skip the header row
    if (!getline(file, line)) {
        cout << "The file is empty.\n";
        return false;
    }

    int lineNumber = 1;

    while (getline(file, line)) {
        lineNumber++;

        if (line.empty())
            continue;

        istringstream row(line);

        string first, last;

        if (!(row >> first >> last))
            continue;

        vector<double> grades;
        double grade;

        while (row >> grade)
            grades.push_back(grade);

        // The last numeric value is the exam grade.
        // Earlier numeric values are homework grades.
        if (grades.size() < 2) {
            cout << "Skipping invalid row " << lineNumber
                 << "\n";
            continue;
        }

        double exam = grades.back();
        grades.pop_back();

        students.emplace_back(first, last, grades, exam);
    }

    file.close();

    if (students.empty()) {
        cout << "No student records were read.\n";
        return false;
    }

    cout << "\nLoaded " << students.size()
         << " students from " << filename << ".\n";

    return true;
}

int main() {
    vector<Person> students;
    int choice;

    cout << "STUDENT FINAL GRADE CALCULATOR\n";
    cout << "------------------------------\n";
    cout << "1. Enter a student manually\n";
    cout << "2. Generate random students\n";
    cout << "3. Read 10,000 students\n";
    cout << "4. Read 100,000 students\n";
    cout << "5. Read 1,000,000 students\n";
    cout << "Choose an option: ";

    if (!(cin >> choice)) {
        cout << "Invalid input.\n";
        return 1;
    }

    if (choice == 1) {
        Person p;

        if (!(cin >> p)) {
            cout << "Invalid student information.\n";
            return 1;
        }

        students.push_back(p);
    }
    else if (choice == 2) {
        int count;

        cout << "How many students? ";
        cin >> count;

        if (!cin || count < 1) {
            cout << "Enter a positive number.\n";
            return 1;
        }

        for (int i = 0; i < count; i++) {
            Person p;
            p.randomGrades();
            students.push_back(p);
        }
    }
    else if (choice >= 3 && choice <= 5) {
        string filename;

        if (choice == 3)
            filename = "students10000.txt";
        else if (choice == 4)
            filename = "students100000.txt";
        else
            filename = "students1000000.txt";

        if (!readStudents(filename, students))
            return 1;
    }
    else {
        cout << "Invalid choice.\n";
        return 1;
    }

    printTable(students);

    cout << "\nPress Enter to exit...";
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
    cin.get();

    return 0;
}
